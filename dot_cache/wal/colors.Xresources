! X colors.
! Generated by 'wal'
*foreground:        #c3c6c7
*background:        #0f1c22
*.foreground:       #c3c6c7
*.background:       #0f1c22
emacs*foreground:   #c3c6c7
emacs*background:   #0f1c22
URxvt*foreground:   #c3c6c7
XTerm*foreground:   #c3c6c7
UXTerm*foreground:  #c3c6c7
URxvt*background:   [100]#0f1c22
XTerm*background:   #0f1c22
UXTerm*background:  #0f1c22
URxvt*cursorColor:  #c3c6c7
XTerm*cursorColor:  #c3c6c7
UXTerm*cursorColor: #c3c6c7
URxvt*borderColor:  [100]#0f1c22

! Colors 0-15.
*.color0: #0f1c22
*color0:  #0f1c22
*.color1: #116B92
*color1:  #116B92
*.color2: #4574A4
*color2:  #4574A4
*.color3: #1295A5
*color3:  #1295A5
*.color4: #6193B0
*color4:  #6193B0
*.color5: #0EA8D6
*color5:  #0EA8D6
*.color6: #0DD6EA
*color6:  #0DD6EA
*.color7: #c3c6c7
*color7:  #c3c6c7
*.color8: #5e6c73
*color8:  #5e6c73
*.color9: #116B92
*color9:  #116B92
*.color10: #4574A4
*color10:  #4574A4
*.color11: #1295A5
*color11:  #1295A5
*.color12: #6193B0
*color12:  #6193B0
*.color13: #0EA8D6
*color13:  #0EA8D6
*.color14: #0DD6EA
*color14:  #0DD6EA
*.color15: #c3c6c7
*color15:  #c3c6c7

! Black color that will not be affected by bold highlighting.
*.color66: #0f1c22
*color66:  #0f1c22

! Xclock colors.
XClock*foreground: #c3c6c7
XClock*background: #0f1c22
XClock*majorColor:  rgba:c3/c6/c7/ff
XClock*minorColor:  rgba:c3/c6/c7/ff
XClock*hourColor:   rgba:c3/c6/c7/ff
XClock*minuteColor: rgba:c3/c6/c7/ff
XClock*secondColor: rgba:c3/c6/c7/ff

! Set depth to make transparency work.
URxvt*depth: 32
