// -*- mode: jsonc -*-
{
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 30, // Waybar height (to be removed for auto height)
    // "width": 2000, // Waybar width
    "spacing": 8, // Gaps between modules (4px)
    // Choose the order of the modules

//	"margin-left":10,
	
    "modules-left": [
		"hyprland/workspaces",
        "custom/cava"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
	"wireplumber",
        "network",
        "cpu",
        "memory",
        "tray",
		"custom/theme-switcher"
    ],
    // Modules configuration
    "tray": {
        //"icon-size": 21,
        "spacing": 10
    },
    "clock": {
        // "timezone": "America/Chicago",
		"format": "{:%H:%M:%S  -  %A, %d}",
		"interval": 1,
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },
    "cpu": {
        "format": "CPU: {usage}%",
        "tooltip": false
    },
    "memory": {
        "format": "MEM:{}%"
    },
  "wireplumber": {
      "format": "VOL:{volume}%",
      "on-click": "pavucontrol",
      "scroll-step": 5
  },
	 "network": {
        "format-wifi": "NET:{signalStrength}%",
        "format-disconnected": "Disconnected"
    },
    "custom/cheat": {
      	"format":"",
       	"on-click": "foot -e less /home/lain/.cheat",
      	"tooltip": false
   },
   "custom/theme-switcher": {
           "format": " ",
           "tooltip": false,
           "on-click": "~/.config/waybar/change-theme.sh",
       },
    "hyprland/workspaces": {
           "format": "{icon}",
           "format-icons": {
             "active": "",
             "default": ""
           }
    },
     "custom/cava": {
   		 "exec": "~/.config/waybar/cava.sh",
    	"format": "{}",
      }
}
