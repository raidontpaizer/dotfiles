{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/Pictures/arch.sixel",
	"type": "raw",
        "height": 15,
	"width": 25,
        "padding": {
            "top": 2,
            "left": 3,
	    "bottom": 0

        }
    },
    "modules": [
       "break",
	    {
            "type": "custom",
            "format": "┏━━━━━━━━━━━━━━━━RAIDFETCH━━━━━━━━━━━━━━━━┓"
        },
        {
            "type": "title",
            "key": " HOST",
            "keyColor": "green"
        },
        {
            "type": "os",
            "key": " DISTRO",
            "keyColor": "green"
        },
        {
	    "type": "cpu",
            "key": " CPU",
	    "keyColor": "green"
	},
	{
            "type": "gpu",
            "key": " GPU",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": " MEM",
            "keyColor": "green"
        },
        {
	    "type": "kernel",
	    "key": " KERNEL",
	    "keyColor": "green"
	},
        {
            "type": "terminal",
            "key": " TERMINAL",
            "keyColor": "green"
        },
        {
            "type": "wm",
            "key": " WM",
            "keyColor": "green"
        },
        {
            "type": "shell",
            "key": " SHELL",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": "┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛"
	},
        {
           "type": "colors",
           "paddingLeft": 2,  
       }
 
    ]
}
